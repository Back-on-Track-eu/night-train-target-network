# =============================================================================
# Night Train Target Network — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/
uv.lock

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/
.nbrun/

# -----------------------------------------------------------------------------
# Node / Frontend
# -----------------------------------------------------------------------------
node_modules/
.parcel-cache/

# Build output, both stacks (Python sdist/wheel and Vite)
dist/

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
backend/docker/.env
# Hand-made backups of the above — they carry the same JWT_SECRET.
backend/docker/.env.bak*
backend/db/dev/.env
.devcontainer/.env
deploy/**/.env
# Server-local compose overrides (per-host worker counts, party rate limits,
# log caps). Never belongs in a public repo — the tracked compose is the contract.
deploy/**/docker-compose.override.yml
credentials/

# -----------------------------------------------------------------------------
# Docker / Infrastructure
# -----------------------------------------------------------------------------
# OpenRailRouting — large source data and its generated graph cache
backend/models/route/routing/docker/data/
backend/models/route/routing/docker/graph-cache/
backend/models/route_evaluation_model/routing/docker/graph-cache/

# Written by the Docker entrypoint at container start
backend/models/route/routing/countries.geojson

# Postgres data volume, when mounted locally
pgdata/

# -----------------------------------------------------------------------------
# Generated data
#
# Everything here is reproducible: re-run the notebook, the seed step or the
# download that produces it. Committing any of it invites silent divergence
# between the artifact and the code that generates it.
# -----------------------------------------------------------------------------
# Calibration observation tables — written by the calib notebooks
# (01_source_extraction.ipynb, then 02_*.ipynb, per domain). Re-run the
# notebooks to regenerate; never hand-edit. The narrative documents these
# produce (CALIBRATION.md, TAC_CALIBRATION.md) stay tracked, following the
# docs/MODEL.md precedent for generated-but-published documents.
backend/models/compositions/calib/data/
backend/models/infrastructure/tac/calib/data/
backend/models/infrastructure/energy_pricing/calib/data/
backend/models/infrastructure/facility/calib/data/
backend/models/infrastructure/route_context/calib/data/
backend/models/infrastructure/stops/charges/data/

# Seed CSVs — regenerated from the calibration notebooks at seed time
backend/models/compositions/calib/seed/
backend/models/infrastructure/tac/calib/seed/
backend/models/infrastructure/energy_pricing/calib/seed/
backend/models/infrastructure/facility/calib/seed/
backend/models/infrastructure/route_context/calib/seed/

# NOT ignored, deliberately: route_context/calib/sources/. It holds an
# extraction from a live database (ONTD timetables against router passage
# times), not a derivation — the calibration cannot reproduce it on a machine
# with no ONTD snapshot, so it travels with the repository like a source
# document. See that package's README.

# Ignored, unlike route_context's: stops/charges/sources/ holds published
# tariff PDFs and spreadsheets — third-party documents that are not ours to
# redistribute. 01_source_extraction.ipynb registers them by filename and
# creates the directory, so a clone without them still runs.
backend/models/infrastructure/stops/charges/sources/

# Downloaded from Drive when absent (ONTD stop catalog, country geometries)
backend/db/dev/data/*.csv
backend/db/dev/data/country_geoms.geojson.gz

# Bulk inputs of the stop classification pipeline — OSM extracts and the
# derived CSVs, downloaded from Drive by stops/data_sources.py when absent.
backend/models/infrastructure/stops/data/

# Scratch output from the manual test scripts in backend/scripts/. Input
# fixtures (tc_1_evaluation_input.json) do not match the pattern and stay
# tracked.
backend/scripts/data/*_output.json

# -----------------------------------------------------------------------------
# Local scratch and tooling
# -----------------------------------------------------------------------------
# Claude snapshot tool output — too large for git
project-snapshot*.zip
.claude/export-temp/

notes/
git_status.txt
test_output.txt

# -----------------------------------------------------------------------------
# OS / Editor
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig

