# =============================================================================
# Night Train — Backend Environment Variables
# =============================================================================
# Copy this file to .env and adjust. Defaults work out of the box for local
# development. Never commit .env to version control.
#
# Single source of truth for the whole dev-side backend. Read by:
#   backend/docker/docker-compose.yml   — main backend stack
#   .devcontainer/docker-compose.yml    — devcontainer overlay on the above
#   backend/db/dev/docker-compose.yml   — standalone schema-inspection stack
#   backend/dev_env.py                  — host-run scripts, tests, ontd loaders
#
# CI copies this file verbatim (`cp .env.example .env`) and then overrides
# JWT_SECRET, AUTH_EMAIL_DEV_MODE, TESTING and ONTD_BOOTSTRAP — see
# .github/workflows/backend-tests.yml. Every uncommented value below must
# therefore stay a working default, not a placeholder.
#
# Placement rules (AGENTS.md "Parameter placement"): a value has exactly ONE
# home. Variables whose default lives in code are listed here COMMENTED OUT,
# name-only — uncomment to override, never restate the default here. Compose
# files may mirror port defaults as ${VAR:-value} fallbacks; those mirrors
# must equal the values in this file.
#
# Server deployments do NOT use this file — deploy/bot-server-app/.env.example
# is their counterpart. Frontend config is a Vite build arg
# (VITE_API_BASE_URL), set in the compose file that builds it.

# ── Ports ────────────────────────────────────────────────────────────────────
# Every port of the dev stack, in one place. HOST ports are what your machine
# publishes (change these when a port clashes locally); CONTAINER ports are
# what services bind inside the stack (rarely need changing).

# API: host side deliberately not 5000 — macOS AirPlay Receiver squats there.
API_HOST_PORT=5050
API_CONTAINER_PORT=5000

# PostgreSQL published port. Pair with POSTGRES_PORT below when changing:
# host-run clients connect through this.
POSTGRES_HOST_PORT=5432

# OpenRailRouting. The CONTAINER ports mirror the engine's own
# models/route/routing/docker/config.yml (server 8989, admin/metrics 8990) —
# GraphHopper reads that file, not this one, so change both together.
OPENRAILROUTING_HOST_PORT=8989
OPENRAILROUTING_CONTAINER_PORT=8989
OPENRAILROUTING_ADMIN_HOST_PORT=8990

# Vite dev server (devcontainer stack only).
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173

# Mathesar UI (backend/db/dev stack only).
MATHESAR_HOST_PORT=8000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_HOST/POSTGRES_PORT are what CLIENTS connect to. Compose overrides
# both for in-network services (service name 'postgres', container port 5432);
# the values here serve host-run tools, which resolve the host through
# dev_env.resolve_host(). Keep POSTGRES_PORT equal to POSTGRES_HOST_PORT.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bot_admin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=target_network_test_db

# ── OpenRailRouting client (models/route/routing/rail_router.py) ─────────────
# OPENRAILROUTING_URL is set by compose for containers and derived from
# OPENRAILROUTING_HOST_PORT by dev_env.py for host-run tools — uncomment only
# to point at a non-standard engine.
# OPENRAILROUTING_URL=
# Profile and per-request timeout defaults live in rail_router.py.
# OPENRAILROUTING_PROFILE=
# OPENRAILROUTING_TIMEOUT=

# ── Routing data files ───────────────────────────────────────────────────────
# Drive file id of the Marine Regions EEZ land union shapefile zip — the
# source for input_params.countries.country_geom. Both container
# entrypoints run backend/scripts/export_country_geoms.py before
# seeding, which downloads this and converts it into
# db/dev/data/country_geoms.geojson.gz (a no-op once that exists).
# The script defaults to 1bEqIfs8F4q7B36lsc2OZfJVx19dDEvOT, same fallback
# arrangement as GRAPH_CACHE_FILE_ID — set this only to point elsewhere.
# EEZ_LAND_UNION_FILE_ID=

# GRAPH_CACHE_PATH was removed on 2026-08-24. The OpenRailRouting graph cache
# is bind-mounted from ../models/route/routing/docker/graph-cache, hardcoded in
# docker-compose.yml: the path is identical on every laptop, in CI and on the
# servers, so it is not a per-environment value and does not belong here.
#
# ACTION for anyone with an .env predating that date: delete your
# GRAPH_CACHE_PATH line. It is ignored now, but if it still holds the old
# container-side /app/... value it was actively wrong — Docker silently bound
# an empty root-owned directory on Linux and failed outright on macOS, so the
# routing engine re-downloaded the ~5-10 GB cache on every start.

# Drive file id of the prebuilt graph cache (~5-10 GB zip). Default lives in
# the routing container's models/route/routing/docker/entrypoint.sh, which
# downloads it on first start when graph-cache/ is empty; CI reads the same
# default from there. Uncomment only to point at a different file.
# GRAPH_CACHE_FILE_ID=

# ── ONTD source workbooks (db/ontd/*.py) ────────────────────────────────────
# Which Google-hosted workbook each ontd loader reads. Public, link-shared
# ("Anyone with the link: Viewer") — ids, not secrets. These have NO code
# default (db/ontd/xlsx_utils.py exits with a message if unset), so this file
# is their home. *_KIND picks the download endpoint:
#   drive_file   (id ~33 chars) — an .xlsx uploaded to Drive, served as stored
#                bytes; formulas frozen at upload.
#   native_sheet (id ~44 chars) — a real Google Sheet, exported on the fly, so
#                a refresh always picks up the editors' latest changes.
#
# ONTD timetable workbook. Currently a Drive .xlsx snapshot rather than the
# live sheet (15zsK-lBuibUtZ1s2FxVHvAmSu-pEuE0NDT6CAMYL2TY), because the stop
# coordinate fixes were applied to a copy — a refresh therefore does NOT pick
# up upstream ONTD changes. Point this back at the native sheet id and set
# ONTD_WORKBOOK_KIND=native_sheet once those fixes are merged upstream.
ONTD_WORKBOOK_ID=1ipyNcfZ6-a38xbAVPpAmTejYhKa6Dl97
ONTD_WORKBOOK_KIND=drive_file

# Target-network composition catalog — imported ONCE into the curated ontd
# tables, after which the DB is source of truth. Frozen by design.
ONTD_COMPOSITIONS_ID=1vSJ-vHKb2uZRG4hMtW-5a--xUz43N6cd
ONTD_COMPOSITIONS_KIND=drive_file

# ── Stop classification pipeline (models/infrastructure/stops) ──────────────
# ONE Drive folder holds every bulk input of the pipeline. stops/data_sources.py
# picks a file out of it by name, syncing the folder into stops/data/ when
# something is missing, so there is one id here rather than one per file.
# It has NO code default — this file is its home, same as the ONTD workbooks
# above. Needed only to RUN the pipeline (steps 2-7); the API and CI need it
# not at all, they consume the finished catalog via STOP_SEED_FILE_ID below.
#
# Syncing uses gdown, in the dev extra (Drive cannot list a folder over plain
# HTTP). A local file always wins — the sync only fills gaps, so a file a step just
# wrote is never overwritten. Unset, or gdown absent, is not fatal: the message
# names the file and you can place it in stops/data/ by hand.
STOPS_DRIVE_FOLDER_ID=1iAjxVKRn1qhgR-yhfczO91M41KIIIIVd

# The catalog itself: every stop the app can plan through, written by
# stops/step7_export_seed_stops.py and read by BOTH db/dev/seed.py (which
# downloads it into db/dev/data/ when absent) and the charge notebook (which
# resolves station names against it). Its default lives in seed.py so CI, which
# copies this file verbatim, seeds without extra configuration — hence this
# line is commented out, name-only, per the placement rule above. Uncomment
# only to point at a different catalog.
# STOP_SEED_FILE_ID=

# ── ONTD bootstrap (db/ontd/bootstrap.py) ───────────────────────────────────
# When the API container loads the ONTD on startup:
#   auto  (default) load once, only while ontd.route_summaries is empty
#   force           reload on every container start (slow: re-routes 205 routes)
#   off             never load — the gallery then shows proposals only
# The load runs in the BACKGROUND, so the API starts immediately either way;
# existing routes appear in the gallery once it finishes. CI rewrites this to
# 'off' (sed on this exact line) and runs bootstrap.py --force --strict as an
# explicit ordered step, because a background load racing pytest skews
# whichever tests it overtakes.
ONTD_BOOTSTRAP=auto

# Concurrent route workers during the ONTD projection — default lives in
# db/ontd/projection.py. Raise for a dedicated router, lower if the routing
# container is shared and under load.
# ONTD_ROUTING_WORKERS=

# ── Mail (adapters/mailer.py) ───────────────────────────────────────────────
# One SMTP lane, two senders: POST /api/feedback notifications and OTP login
# codes. Feedback is still stored in admin.feedback if these are unset or
# sending fails; an OTP that cannot be sent is a hard 502, since a code that
# never arrives is a dead login. STARTTLS is used unconditionally (port 587 is
# the standard STARTTLS submission port).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope From address — defaults to SMTP_USER if left blank
SMTP_FROM=
# Recipient for every feedback submission — default lives in mailer.py.
# FEEDBACK_NOTIFY_EMAIL=

# ── Auth: local plane (api/auth.py, api/auth_middleware.py) ─────────────────
# REQUIRED — the API refuses to start without it (api/auth_utils.py's
# check_auth_config runs at boot). Signs the local-plane JWTs (OTP
# contributors + guests).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# true = log OTP codes at WARNING level instead of emailing them, so the full
# login flow runs without SMTP (local dev / CI only — NEVER on a public
# deployment). scripts/test_auth_chain.py reads the code straight out of
# `docker logs` when this is on.
AUTH_EMAIL_DEV_MODE=false
# true = disable per-IP rate limits on the auth endpoints (local dev / CI)
TESTING=false

# ── Auth: OIDC plane — "Sign in with BoT account" (api/auth_oidc.py) ────────
# DORMANT until ISSUER_URL and CLIENT_ID are both set; activates when BoT's
# central identity (Keycloak realm) goes live. No code change at flip time.
# Setting the issuer without the client id is a boot error, not a warning —
# the audience check is not optional once OIDC is on.
# KEYCLOAK_ISSUER_URL=https://auth.back-on-track.eu/realms/bot
# KEYCLOAK_CLIENT_ID=target-network
# Optional override; derived from the issuer by default:
# KEYCLOAK_JWKS_URL=

# ── API operational limits (api/config.py) ──────────────────────────────────
# Caps on the HTTP layer. All defaults live in api/config.py — uncomment to
# override, never restate them here. Rate limits are Flask-Limiter strings
# (";"-separated for several windows). Engagement limits bucket per
# authenticated user; the auth ones per IP, since those callers have no
# identity yet. Note the multi-worker caveat in api/limiter.py: storage is
# per-process memory, so under gunicorn the effective ceiling is
# (limit x workers).
# COMMENT_BODY_MAX_LEN=
# COMMENT_RATE_LIMIT=
# COMMENT_EDIT_RATE_LIMIT=
# LIKE_RATE_LIMIT=
# AUTH_REQUEST_CODE_RATE_LIMIT=
# AUTH_GUEST_RATE_LIMIT=
# OTP_TTL_MINUTES=
# JWT_TTL_DAYS=
# GUEST_TTL_DAYS=
# FEEDBACK_SUBJECT_MAX_LEN=
# PROPOSALS_DEFAULT_LIMIT=

# Response compression (main.py's Compress(app)). Nothing in front of the app
# compresses — gunicorn cannot, and the servers' Caddy vhost has no `encode`
# directive — so Flask does it. The level is deliberately low: sync workers
# mean a worker spending CPU on gzip is a worker serving nobody.
# COMPRESS_LEVEL=
# COMPRESS_MIN_SIZE=

# Proposal statistics (api/proposal_stats.py). How many countries and
# country-to-country relations the top/flop rankings return, and how far
# apart two countries may be BY RAIL and still count as a relation one
# night train could plausibly connect. The distance ceiling is used
# twice: scripts/build_country_relations.py builds the candidate set up
# to it, and the API filters on it — keep both on one value.
# PROPOSALS_STATS_COUNTRY_TOP=
# PROPOSALS_STATS_COUNTRY_FLOP=
# PROPOSALS_STATS_RELATION_MAX_KM=

# Pairs routed concurrently when that candidate set is built
# (adapters/routing_context.py). Shared with the ONTD projection's own
# ONTD_ROUTING_WORKERS; the router container is shared, so raise both
# together or neither.
# REFERENCE_ROUTING_WORKERS=

# ── Compute cache (adapters/proposal/compute_cache.py) ──────────────────────
# The §2.3 server-side compute cache (WP13). Defaults live in
# compute_cache.py. TTL bounds how long a computed result may be served; the
# cleanup probability is the fraction of cache WRITES that also run the TTL
# delete sweep (opportunistic disk hygiene — expired rows are never served
# regardless). Retuning either is a deployment decision, never a model bump.
# COMPUTE_CACHE_TTL_HOURS=
# COMPUTE_CACHE_CLEANUP_PROBABILITY=

# ── Google Sheets service account (adapters/data_loader_from_spreadsheet.py) ─
# DORMANT — that loader has no callers today. Kept documented because it is
# the planned basis for the ONTD import rework. Path to a service-account
# JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Host-side tooling ───────────────────────────────────────────────────────
# Read by backend/dev_env.py (which loads THIS file) for tests/ and scripts/.
# All optional; shown name-only because their defaults live in dev_env.py or
# are derived from the port variables above.
#   API_BASE_URL         full override of where tools reach the API
#                        (otherwise http://localhost:API_HOST_PORT)
#   API_CONTAINER_NAME   for `docker logs`/`docker exec` in scripts
#   AUTH_EMAIL           inbox for scripts/test_auth_chain.py (--email wins)
#   AUTH_NAME            display_name on first registration (--name wins)
# API_BASE_URL=
# API_CONTAINER_NAME=
# AUTH_EMAIL=
# AUTH_NAME=
