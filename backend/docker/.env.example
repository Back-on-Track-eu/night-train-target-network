# =============================================================================
# Night Train — Backend Environment Variables
# =============================================================================
# Copy to .env and adjust. Every uncommented value works out of the box for
# local development. Never commit .env.
#
# Read by: backend/docker/docker-compose.yml, .devcontainer/docker-compose.yml,
# backend/db/dev/docker-compose.yml, backend/dev_env.py (host-run tools).
# Servers use deploy/bot-server-app/.env.example instead.
#
# PLACEMENT RULE (AGENTS.md): every value has exactly one home. A variable
# whose default lives in code appears here COMMENTED OUT, name-only —
# uncomment to override, never restate the default. Compose may mirror port
# defaults as ${VAR:-value}; those mirrors must match this file.
#
# CI copies this file verbatim and overrides JWT_SECRET, AUTH_EMAIL_DEV_MODE,
# TESTING and ONTD_BOOTSTRAP (.github/workflows/backend-tests.yml).


# =============================================================================
# 1. Ports
# =============================================================================
# HOST ports are what your machine publishes — change on a local clash.
# CONTAINER ports are what services bind inside the stack.

# Host side is not 5000: macOS AirPlay Receiver squats there.
API_HOST_PORT=5050
API_CONTAINER_PORT=5000

# Keep equal to POSTGRES_PORT below — host-run clients connect through it.
POSTGRES_HOST_PORT=5432

# Routing engine — ONE INSTANCE PER GRAPH, so every port is suffixed with the
# graph key. infra_2026 is today's network, infra_2032 the upgraded one
# (Fehmarn fixed link and the rest of Jasper's 2032 extract). Both are live;
# the 2032 pair is inert whenever that instance is switched off in section 3.
OPENRAILROUTING_HOST_PORT_INFRA_2026=8989
OPENRAILROUTING_ADMIN_HOST_PORT_INFRA_2026=8990
OPENRAILROUTING_HOST_PORT_INFRA_2032=8991
OPENRAILROUTING_ADMIN_HOST_PORT_INFRA_2032=8992

# NOT per graph: all instances run the same image and config.yml, so they bind
# the same port inside the stack. Mirrors the engine's own config.yml (server
# 8989, admin 8990) — GraphHopper reads that file, not this one.
OPENRAILROUTING_CONTAINER_PORT=8989

# Vite dev server (devcontainer stack only).
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173

# Mathesar UI (backend/db/dev stack only).
MATHESAR_HOST_PORT=8000


# =============================================================================
# 2. PostgreSQL
# =============================================================================
# HOST/PORT are what CLIENTS connect to. Compose overrides both for in-network
# services; these values serve host-run tools via dev_env.resolve_host().
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bot_admin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=target_network_test_db


# =============================================================================
# 3. Routing engine
# =============================================================================
# One OpenRailRouting instance per routing graph. Scenarios pick theirs via
# scenario.scenarios.routing_graph_key; the key -> URL mapping is deployment
# config and lives here. EVERY per-graph setting is suffixed with the graph
# key, uppercased — the default graph included, so no instance is implicitly
# "the" router:
#
#   OPENRAILROUTING_URL_<KEY>              backend registry entry
#   OPENRAILROUTING_HOST_PORT_<KEY>        published port        (section 1)
#   OPENRAILROUTING_ADMIN_HOST_PORT_<KEY>  published admin port  (section 1)
#   GRAPH_CACHE_FILE_ID_<KEY>              prebuilt cache        (section 4)
#
# Adding a graph is those four variables plus a compose service — no code.
# Contract: models/route/routing/rail_router.py. Registry:
# api/helpers/dependencies.py.

# --- infra_2026: today's network (the default graph) -------------------------
# Set by compose for containers, and by dev_env.py for host-run tools from
# OPENRAILROUTING_HOST_PORT_INFRA_2026 — uncomment only for a non-standard
# engine.
# OPENRAILROUTING_URL_INFRA_2026=

# --- infra_2032: upgraded network -------------------------------------------
# The graph EXISTS (imported 2026-08-31 from Jasper's 2032 extract), but the
# instance stays OPT-IN: it is a second container plus ~1.2 GB of graph cache
# on disk, and no seeded scenario pins the key yet. Uncomment all three to
# enable — COMPOSE_PROFILES starts the container (compose reads it natively),
# the URL registers the key in the backend registry, and the file id feeds the
# entrypoint download into
# models/route/routing/docker/graph-cache-infra-2032/. An unset URL means "not
# configured": a scenario pinning this key then fails loudly rather than
# silently routing on the wrong network.
#
# The id is spelled out rather than left blank because this graph has no code
# default (infra_2026's lives in entrypoint.sh, and a container serves exactly
# one graph, so there can only be one such fallback). This file is where it is
# written down.
# Host-run tools need no override: dev_env.resolve_routing_urls() rewrites
# every configured graph's URL onto localhost and that graph's own published
# port above.
# COMPOSE_PROFILES=infra-2032
# OPENRAILROUTING_URL_INFRA_2032=http://openrailrouting-infra-2032:8989
# GRAPH_CACHE_FILE_ID_INFRA_2032=15lV2gKyHwljBtbmsOOHA2pWkYHNNjW_a

# --- Not per graph ----------------------------------------------------------
# Profile and per-request timeout defaults live in rail_router.py.
# OPENRAILROUTING_PROFILE=
# OPENRAILROUTING_TIMEOUT=

# Unsuffixed OPENRAILROUTING_URL is honoured for the DEFAULT graph only, as a
# compatibility path for the server stacks under deploy/, which set it and know
# nothing about graph keys. The dev stack and CI use the suffixed form; do not
# set this here.
# OPENRAILROUTING_URL=

# --- Route segment cache ----------------------------------------------------
# Every routed stop pair is stored per graph in route_cache.route_segments and
# served from there next time; misses route live and store themselves. On by
# default — set false only to diagnose (docs/DEPLOY_HANDOVER.md §7a).
# ROUTE_SEGMENT_CACHE_ENABLED=true

# =============================================================================
# 4. Drive-hosted data
# =============================================================================
# No large data in the repo. Ids are public and link-shared — not secrets.
# Everything here has a code default EXCEPT the two ONTD workbooks and the
# stops folder, which have none and are therefore set below.

# Prebuilt graph cache (~215 MB zip), one per graph. The infra_2026 default
# lives in models/route/routing/docker/entrypoint.sh, which downloads it on
# first start when the graph-cache directory is empty; CI reads the same
# default. The 2032 id is in section 3, with the rest of that instance.
# Note the container-side variable is unsuffixed (a container serves one graph
# and does not know its key) — compose maps the suffixed name onto it.
# GRAPH_CACHE_FILE_ID_INFRA_2026=

# Marine Regions EEZ land union — source for input_params.countries
# .country_geom. scripts/export_country_geoms.py downloads and converts it to
# db/dev/data/country_geoms.geojson.gz before seeding (no-op once present).
# EEZ_LAND_UNION_FILE_ID=

# Stop catalog: every stop the app can plan through, written by
# stops/step7_export_seed_stops.py. Default lives in db/dev/seed.py so CI seeds
# without configuration. Regenerate, then upload as a NEW VERSION of the same
# Drive file so the id survives.
# STOP_SEED_FILE_ID=

# ONTD source workbooks (db/ontd/*.py). *_KIND picks the download endpoint:
#   drive_file    an .xlsx on Drive, served as stored bytes (formulas frozen)
#   native_sheet  a real Google Sheet, exported live on each refresh
# The timetable is a Drive snapshot, not the live sheet
# (15zsK-lBuibUtZ1s2FxVHvAmSu-pEuE0NDT6CAMYL2TY), because the stop coordinate
# fixes were applied to a copy — refreshes do NOT pick up upstream ONTD
# changes. Point back at the native sheet id once those fixes land upstream.
ONTD_WORKBOOK_ID=1ipyNcfZ6-a38xbAVPpAmTejYhKa6Dl97
ONTD_WORKBOOK_KIND=drive_file

# Composition catalog — imported ONCE, after which the DB is source of truth.
ONTD_COMPOSITIONS_ID=1vSJ-vHKb2uZRG4hMtW-5a--xUz43N6cd
ONTD_COMPOSITIONS_KIND=drive_file

# Stop classification pipeline inputs (models/infrastructure/stops). One folder
# holds every bulk file; data_sources.py syncs it into stops/data/ on demand
# via gdown (dev extra). A local file always wins — the sync only fills gaps.
# Needed only to RUN the pipeline (steps 2-7); the API and CI never touch it.
STOPS_DRIVE_FOLDER_ID=1iAjxVKRn1qhgR-yhfczO91M41KIIIIVd

# Energy model calibration inputs (models/energy/calib). Same folder
# pattern as the stops pipeline above: needed only to RUN the calibration
# notebooks, never by the API or CI, which consume the committed
# coefficients in models/energy/calibrated_coefficients.py.
ENERGY_DRIVE_FOLDER_ID=13h44o0Ok-kK2U9hJ22Y5vMdgfCrEICJF


# =============================================================================
# 5. ONTD bootstrap (db/ontd/bootstrap.py)
# =============================================================================
# When the API container loads existing night trains on startup:
#   auto   load once, while ontd.route_summaries is empty; re-project when the
#          stop catalog has moved on
#   force  reload on every start — slow, re-routes ~205 routes. Required after
#          a stop catalog change or a router change, then set back to auto.
#   off    never load; the gallery then shows proposals only
# Runs in the BACKGROUND, so the API is up either way. CI rewrites this line to
# 'off' and runs bootstrap.py --force --strict as an explicit ordered step.
ONTD_BOOTSTRAP=auto

# Concurrent route workers during the projection — default in projection.py.
# Shares the router with REFERENCE_ROUTING_WORKERS: raise both or neither.
# ONTD_ROUTING_WORKERS=


# =============================================================================
# 6. Mail (adapters/mailer.py)
# =============================================================================
# One SMTP lane, two senders: feedback notifications and OTP login codes.
# Feedback still stores in admin.feedback if unset or sending fails; an OTP
# that cannot be sent is a hard 502. STARTTLS always (587 is its usual port).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope From — defaults to SMTP_USER when blank.
SMTP_FROM=
# Recipient for feedback submissions — default in mailer.py.
# FEEDBACK_NOTIFY_EMAIL=


# =============================================================================
# 7. Authentication
# =============================================================================
# --- Local plane (api/auth.py, api/auth_middleware.py) -----------------------
# REQUIRED — the API refuses to start without it (api/auth_utils.py's
# check_auth_config at boot). Signs local-plane JWTs (OTP contributors, guests).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# true = log OTP codes at WARNING instead of emailing, so the login flow runs
# without SMTP. LOCAL DEV / CI ONLY — never on a public deployment.
AUTH_EMAIL_DEV_MODE=false
# true = disable per-IP rate limits on the auth endpoints (local dev / CI).
TESTING=false

# --- OIDC plane: "Sign in with BoT account" (api/auth_oidc.py) ---------------
# DORMANT until issuer and client id are BOTH set; activates when BoT's
# Keycloak realm goes live, with no code change. Issuer without client id is a
# boot error, not a warning — the audience check is not optional.
# KEYCLOAK_ISSUER_URL=https://auth.back-on-track.eu/realms/bot
# KEYCLOAK_CLIENT_ID=target-network
# Derived from the issuer unless overridden:
# KEYCLOAK_JWKS_URL=


# =============================================================================
# 8. API tuning
# =============================================================================
# All defaults live in code — uncomment to override, never restate.

# HTTP-layer caps (api/config.py). Rate limits are Flask-Limiter strings
# (";"-separated for several windows); engagement limits bucket per user, auth
# limits per IP. Limiter storage is per-process memory, so under gunicorn the
# effective ceiling is (limit x workers) — see api/limiter.py.
# COMMENT_BODY_MAX_LEN=
# COMMENT_RATE_LIMIT=
# COMMENT_EDIT_RATE_LIMIT=
# LIKE_RATE_LIMIT=
# AUTH_REQUEST_CODE_RATE_LIMIT=
# AUTH_GUEST_RATE_LIMIT=
# FEEDBACK_RATE_LIMIT=
# OTP_TTL_MINUTES=
# JWT_TTL_DAYS=
# GUEST_TTL_DAYS=
# FEEDBACK_SUBJECT_MAX_LEN=
# PROPOSALS_DEFAULT_LIMIT=

# Response compression (main.py). Nothing in front of the app compresses, so
# Flask does. The level is deliberately low: with sync workers, a worker
# spending CPU on gzip is a worker serving nobody.
# COMPRESS_LEVEL=
# COMPRESS_MIN_SIZE=

# Proposal statistics (api/proposal_stats.py) — how many countries and
# relations the top/flop rankings return, and how far apart two countries may
# be BY RAIL and still count as a relation. The distance ceiling is used twice
# (scripts/build_country_relations.py builds the candidate set to it, the API
# filters on it): keep both on one value.
# PROPOSALS_STATS_COUNTRY_TOP=
# PROPOSALS_STATS_COUNTRY_FLOP=
# PROPOSALS_STATS_RELATION_MAX_KM=

# Pairs routed concurrently when that candidate set is built
# (adapters/routing_context.py). See ONTD_ROUTING_WORKERS above.
# REFERENCE_ROUTING_WORKERS=

# Compute cache (adapters/proposal/compute_cache.py). TTL bounds how long a
# result may be served; the cleanup probability is the fraction of cache WRITES
# that also run the TTL sweep (expired rows are never served regardless).
# Retuning either is a deployment decision, never a model bump.
# COMPUTE_CACHE_TTL_HOURS=
# COMPUTE_CACHE_CLEANUP_PROBABILITY=


# =============================================================================
# 9. Host-side tooling (backend/dev_env.py)
# =============================================================================
# For tests/ and scripts/. All optional — defaults live in dev_env.py or derive
# from the ports above.
#   API_BASE_URL        where tools reach the API (else localhost:API_HOST_PORT)
#   API_CONTAINER_NAME  for `docker logs` / `docker exec` in scripts
#   AUTH_EMAIL          inbox for scripts/test_auth_chain.py (--email wins)
#   AUTH_NAME           display_name on first registration (--name wins)
# API_BASE_URL=
# API_CONTAINER_NAME=
# AUTH_EMAIL=
# AUTH_NAME=


# =============================================================================
# 10. Dormant
# =============================================================================
# Google Sheets service account (adapters/data_loader_from_spreadsheet.py) —
# no callers today; kept as the planned basis for the ONTD import rework.
# Path to a service-account JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=


# =============================================================================
# Removed variables — delete these lines if your .env still has them
# =============================================================================
#   GRAPH_CACHE_PATH        (2026-08-24) the cache is bind-mounted at a fixed
#                           repo-relative path per graph; a stale value here
#                           bound an empty directory and forced a ~215 MB
#                           re-download on every start.
#   COUNTRIES_GEOJSON_PATH  (2026-08) superseded by export_country_geoms.py,
#                           which writes db/dev/data/country_geoms.geojson.gz.
