# =============================================================================
# Night Train — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# This is the single source of truth for all backend configuration.
# Used by:
#   backend/docker/docker-compose.yml  — main backend stack
#   .devcontainer/docker-compose.yml   — VS Code dev container

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_USER=bot_admin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=target_network_test_db
POSTGRES_PORT=5432

# ── OpenRailRouting ──────────────────────────────────────────────────────────
# Host port exposed on the Docker host machine (for local tools like Postman)
OPENRAILROUTING_HOST_PORT=8989
# Internal container port (used for inter-container communication)
OPENRAILROUTING_CONTAINER_PORT=8989
# Full URL used by the API container to reach the routing engine
OPENRAILROUTING_URL=http://openrailrouting:8989
OPENRAILROUTING_PROFILE=night_train
OPENRAILROUTING_TIMEOUT=30

# ── Routing data files ───────────────────────────────────────────────────────
# Path to Natural Earth country polygons GeoJSON (baked into Docker image at build time)
COUNTRIES_GEOJSON_PATH=/app/models/route/routing/countries.geojson

# Download URL for country polygons — used by Dockerfile at build time and
# referenced in error messages if the file is missing in local dev
NATURAL_EARTH_COUNTRIES_URL=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson

# Path to OpenRailRouting graph cache (mounted as Docker volume — large, not in git)
GRAPH_CACHE_PATH=/app/models/route/routing/docker/graph-cache

# Drive file id of the prebuilt routing graph cache (~5-10 GB zip), downloaded
# by the routing container's entrypoint.sh on first start when graph-cache/ is
# empty. Lives in 00_large_data/01_graph_cache/ on the target-network Drive.
GRAPH_CACHE_FILE_ID=1tWt1OX7mzPA7Ylo9KqmTK6YluRXEtt8z

# ── ONTD source workbooks (db/ontd/*.py) ────────────────────────────────────
# Which Google-hosted workbook each ontd loader reads. Public, link-shared
# ("Anyone with the link: Viewer") — ids, not secrets, hence documented here.
# db/ontd/sources.py turns each id into a download URL, using *_KIND to pick
# the right endpoint:
#   drive_file   (id ~33 chars, share link carries rtpof=true) — an .xlsx
#                uploaded to Drive, served as stored bytes. Formulas are NOT
#                recalculated, so values are frozen at upload.
#   native_sheet (id ~44 chars) — a real Google Sheet, exported on the fly, so
#                a refresh always picks up the editors' latest changes.
#
# ONTD timetable workbook. Currently a Drive .xlsx snapshot rather than the
# live sheet (15zsK-lBuibUtZ1s2FxVHvAmSu-pEuE0NDT6CAMYL2TY), because the stop
# coordinate fixes were applied to a copy — a refresh therefore does NOT pick
# up upstream ONTD changes. Point this back at the native sheet id and set
# ONTD_WORKBOOK_KIND=native_sheet once those fixes are merged upstream.
ONTD_WORKBOOK_ID=1ipyNcfZ6-a38xbAVPpAmTejYhKa6Dl97
ONTD_WORKBOOK_KIND=drive_file

# Target-network composition catalog — imported ONCE into the curated ontd
# tables, after which the DB is source of truth. Frozen by design.
ONTD_COMPOSITIONS_ID=1vSJ-vHKb2uZRG4hMtW-5a--xUz43N6cd
ONTD_COMPOSITIONS_KIND=drive_file

# When the API container should load the ONTD on startup (db/ontd/bootstrap.py):
#   auto  (default) load once, only while ontd.route_summaries is empty
#   force           reload on every container start (slow: re-routes 205 routes)
#   off             never load — the gallery then shows proposals only
# The load runs in the BACKGROUND, so the API starts immediately either
# way; existing routes appear in the gallery once it finishes.
ONTD_BOOTSTRAP=auto

# How many routes to route concurrently during the ONTD projection.
# Routing is HTTP-bound, so this is what determines how long the load
# takes (~8x faster at 8 than serially). Raise for a dedicated router,
# lower if the routing container is shared and under load.
ONTD_ROUTING_WORKERS=8

# ── Feedback mail (adapters/mailer.py) ──────────────────────────────────────
# SMTP credentials used to send POST /api/feedback notifications. Feedback is
# still stored in admin.feedback if these are unset or sending fails — see
# mailer.py's module docstring. STARTTLS is used unconditionally (SMTP_PORT
# 587 is the standard STARTTLS submission port).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope From address — defaults to SMTP_USER if left blank
SMTP_FROM=
# Recipient for every feedback submission
FEEDBACK_NOTIFY_EMAIL=targetnetwork-wg@back-on-track.eu

# ── Auth (api/auth.py, api/auth_middleware.py) ───────────────────────────────
# REQUIRED — the API refuses to start without it. Signs the local-plane
# JWTs (OTP contributors + guests). Generate: openssl rand -base64 48
JWT_SECRET=
# true = log OTP codes instead of emailing them (local dev / CI only —
# NEVER on a public deployment). OTP mail otherwise uses the SMTP_* block
# above, same lane as feedback mail.
AUTH_EMAIL_DEV_MODE=false
# true = disable per-IP rate limits on the auth endpoints (local dev / CI)
TESTING=false

# ── Engagement limits (api/config.py) ───────────────────────────────────────
# Operational caps on the proposal engagement endpoints. All optional —
# api/config.py carries the defaults shown, so an unset value here is the
# supported case, not a missing one. Rate limits are Flask-Limiter strings
# (";"-separated for several windows) bucketed per authenticated user; the
# auth-endpoint limits above them are per IP, since those callers have no
# identity yet. Note the multi-worker caveat in api/limiter.py: storage is
# per-process memory, so under gunicorn the effective ceiling is
# (limit x workers).
# COMMENT_BODY_MAX_LEN=4000
# COMMENT_RATE_LIMIT=10 per minute;60 per hour
# COMMENT_EDIT_RATE_LIMIT=20 per minute;120 per hour
# LIKE_RATE_LIMIT=60 per minute
# AUTH_REQUEST_CODE_RATE_LIMIT=5 per hour
# AUTH_GUEST_RATE_LIMIT=20 per hour

# ── Compute cache (adapters/proposal/compute_cache.py) ──────────────────────
# The §2.3 server-side compute cache (WP13). Both optional — the code
# carries the defaults shown, so an unset value here is the supported
# case, not a missing one. TTL bounds how long a computed result may be
# served; the cleanup probability is the fraction of cache WRITES that
# also run the TTL delete sweep (opportunistic — no scheduler; expired
# rows are never served regardless, the sweep is disk hygiene only).
# Retuning either is a deployment decision, never a model-version bump.
# COMPUTE_CACHE_TTL_HOURS=3
# COMPUTE_CACHE_CLEANUP_PROBABILITY=0.01

# ── "Sign in with BoT account" — Keycloak OIDC operator plane ────────────────
# DORMANT until both are set; activates when BoT's central identity
# (Keycloak realm) goes live. No code change needed at flip time.
# KEYCLOAK_ISSUER_URL=https://auth.back-on-track.eu/realms/bot
# KEYCLOAK_CLIENT_ID=target-network
# Optional override; derived from the issuer by default:
# KEYCLOAK_JWKS_URL=
