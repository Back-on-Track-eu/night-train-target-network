   "source": [
    "### However!\n",
    "A better approach is, because of the kWh/km output requirement, to first calculate kWh/km and then multiply the distance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "eaee3701-d4ed-4688-bc9f-884cf8557092",
   "metadata": {},
   "outputs": [],
   "source": [
    "data[\"energy_kwh_per_km\"] = (\n",
    "    data[\"energy_kwh\"] / data[\"distance_km\"]\n",
    ")\n",
    "\n",
    "train[\"energy_kwh_per_km\"] = (\n",
    "    train[\"energy_kwh\"] / train[\"distance_km\"]\n",
    ")\n",
    "\n",
    "test[\"energy_kwh_per_km\"] = (\n",
    "    test[\"energy_kwh\"] / test[\"distance_km\"]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "3d082348-361c-4d5e-9b9b-22d832779c79",
   "metadata": {},
   "outputs": [],
   "source": [
    "model_intensity_base = smf.ols(\n",
    "    \"\"\"\n",
    "    energy_kwh_per_km\n",
    "    ~ weight_t\n",
    "    + avg_speed_kmh\n",
    "    + v_max_kmh\n",
    "    \"\"\",\n",
    "    data=train\n",
    ").fit()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "1a9a9231-718e-4c3a-8bd5-0c9829a8a44d",
   "metadata": {},
   "outputs": [],
   "source": [
    "model_intensity_nonlinear = smf.ols(\n",
    "    \"\"\"\n",
    "    energy_kwh_per_km\n",
    "    ~ weight_t\n",
    "    + avg_speed_kmh\n",
    "    + I(avg_speed_kmh ** 2)\n",
    "    + v_max_kmh\n",
    "    + I(v_max_kmh ** 2)\n",
    "    \"\"\",\n",
    "    data=train\n",
    ").fit()"
   ]
  },
