   "id": "cefb2c2d-349c-4444-a2ff-1b45580fe7c9",
   "metadata": {},
   "source": [
    "Now test whether we need a quadratic distance term"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "8553a01c-9a1e-4b2f-99fb-0f8f033188a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "formula_interaction = \"\"\"\n",
    "energy_kwh\n",
    "~ distance_c\n",
    "+ weight_c\n",
    "+ speed_c\n",
    "+ vmax_c\n",
    "+ distance_c:weight_c\n",
    "+ distance_c:vmax_c\n",
    "\"\"\"\n",
    "\n",
    "formula_quadratic = \"\"\"\n",
    "energy_kwh\n",
    "~ distance_c\n",
    "+ I(distance_c ** 2)\n",
    "+ weight_c\n",
    "+ speed_c\n",
    "+ vmax_c\n",
    "+ distance_c:weight_c\n",
    "+ distance_c:vmax_c\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b79cbc07-6d77-4d34-a9ea-1ab77ec7d61c",
   "metadata": {},
   "outputs": [
    {
