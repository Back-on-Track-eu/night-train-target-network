# Production-style static build for the bot-server demo stack
# (deploy/bot-server-demo/). The default Dockerfile runs the Vite dev
# server; this one ships the built assets behind nginx.
#
# VITE_API_BASE_URL is baked in at build time. The demo stack sets it to
# "" (empty) so the app calls /api/* on its own origin and Caddy routes
# those to the API container — see deploy/bot-server-demo/README.md.
#
# This image also serves the public documentation site at /docs/. It is
# built from the `docssrc` named build context (docs-site/) rather than by
# widening this build's context to the repo root — that would ship
# backend/, .git/ and the multi-GB routing graph cache into every frontend
# build. The compose files supply it via build.additional_contexts.

FROM node:22-alpine AS docs

WORKDIR /docs

COPY --from=docssrc package.json package-lock.json ./
RUN npm ci

COPY --from=docssrc . .

# base '/docs/' is set in .vitepress/config.ts — without it the docs and the
# SPA would both emit absolute /assets/* URLs and collide on this one origin.
RUN npm run build

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# vite build directly — vue-tsc typechecking belongs in CI, not in the
# deploy path (a non-blocking type error must not take the demo down).
RUN npx vite build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
# The docs site is a separate static bundle under /docs/, matched by its own
# nginx location ahead of the SPA catch-all.
COPY --from=docs /docs/.vitepress/dist /usr/share/nginx/html/docs
# SPA fallback (try_files -> index.html) so vue-router history-mode routes
# survive a direct load/refresh, not just in-app navigation.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
